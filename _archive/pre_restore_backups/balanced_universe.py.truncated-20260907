imum_median_dollar_volume < 0.0:
            raise ValueError("minimum_median_dollar_volume cannot be negative.")
        if self.minimum_sectors < 1:
            raise ValueError("minimum_sectors must be at least 1.")
        if self.selection_lag_months < 1:
            raise ValueError("selection_lag_months must be at least 1.")


MARKET_FEATURE_COLUMNS = (
    "market_cap_usd",
    "price",
    "dollar_volume_20d",
)

# CRSP uses these placeholders when the newer UES/ICB classifications are not
# available for an older security record.  They are not economic sectors and
# must not become a single artificial HRP cluster; SIC is the causal fallback.
_MISSING_SECTOR_LABELS = frozenset({"", "NOAVAIL", "N/A", "NA", "NONE", "NULL"})


def _require_columns(
    frame: pd.DataFrame,
    required: set[str],
    label: str,
) -> None:
    missing = required.difference(frame.columns)
    if missing:
        raise ValueError(f"{label} is missing columns: {sorted(missing)}")


def _normalize_asset_ids(values: pd.Series) -> pd.Series:
    """Undo the common ``10001.0`` PERMNO representation created by CSV I/O."""

    return values.astype("string").str.strip().str.replace(r"\.0$", "", regex=True)


def _usable_sector_labels(values: pd.Series) -> pd.Series:
    """Convert CRSP placeholder classifications to missing values."""

    labels = values.astype("string").str.strip()
    return labels.mask(labels.str.upper().isin(_MISSING_SECTOR_LABELS))


def _sic_sector_labels(values: pd.Series) -> pd.Series:
    """Build stable broad fallback labels from the first two SIC digits."""

    sic_prefix = values.astype("string").str.extract(r"(\d{2})", expand=False)
    return ("SIC_" + sic_prefix).astype("string").where(sic_prefix.notna())


def merge_point_in_time_characteristics(
    structural_features: pd.DataFrame,
    characteristics: pd.DataFrame,
    *,
    columns: tuple[str, ...] = ("book_to_market",),
) -> pd.DataFrame:
    """Merge already-causal weekly characteristics onto market features.

    The characteristic file must be keyed by an explicit formation date and
    PERMNO/asset. An exact-date merge is intentional: silently carrying an
    undated accounting observation forward would bypass the release-date and
    staleness controls in the Compustat feature builder.
    """

    left = structural_features.copy()
    right = characteristics.copy()
    asset_column = "asset" if "asset" in right.columns else "permno"
    _require_columns(left, {"formation_date", "asset"}, "Structural features")
    _require_columns(
        right,
        {"formation_date", asset_column, *columns},
        "Point-in-time characteristic table",
    )

    left["formation_date"] = pd.to_datetime(left["formation_date"], errors="raise")
    right["formation_date"] = pd.to_datetime(right["formation_date"], errors="raise")
    left["asset"] = _normalize_asset_ids(left["asset"])
    right["asset"] = _normalize_asset_ids(right[asset_column])
    if right.duplicated(["formation_date", "asset"]).any():
        raise ValueError(
            "Point-in-time characteristic table has duplicate formation-date/asset rows."
        )
    for column in columns:
        right[column] = pd.to_numeric(right[column], errors="coerce")
    right = right[["formation_date", "asset", *columns]]
    # The explicitly supplied characteristic table owns these fields. Keeping
    # an older copy from the market feature file would make the merge ambiguous.
    left = left.drop(columns=list(columns), errors="ignore")
    return left.merge(
        right,
        on=["formation_date", "asset"],
        how="left",
        validate="one_to_one",
    )


def attach_point_in_time_sectors(
    structural_features: pd.DataFrame,
    sector_history: pd.DataFrame,
) -> pd.DataFrame:
    """Attach the sector classification effective on each feature date."""

    features = structural_features.copy()
    history = sector_history.copy()
    _require_columns(
        features,
        {"formation_date", "asset", *MARKET_FEATURE_COLUMNS},
        "Structural features",
    )
    _require_columns(
        history,
        {"permno", "sec_info_start", "sec_info_end", "sector"},
        "Sector history",
    )

    features["formation_date"] = pd.to_datetime(
        features["formation_date"], errors="raise"
    )
    features["asset"] = _normalize_asset_ids(features["asset"])
    history["asset"] = _normalize_asset_ids(history["permno"])
    history["sec_info_start"] = pd.to_datetime(
        history["sec_info_start"], errors="raise"
    )
    # Active CRSP records may use an end date beyond pandas' nanosecond range.
    # Treat an unrepresentable/missing end as open-ended after requiring a
    # valid start date.
    history["sec_info_end"] = pd.to_datetime(
        history["sec_info_end"], errors="coerce"
    ).fillna(pd.Timestamp.max.normalize())
    history["sector"] = _usable_sector_labels(history["sector"])
    # Older CRSP records commonly have no UES/ICB label.  Derive the same
    # broad two-digit SIC branch used by the downloader, so saved histories
    # created before this fix are also repaired when read.
    if "sic_code" in history:
        history["sector"] = history["sector"].fillna(
            _sic_sector_labels(history["sic_code"])
        )

    duplicate_starts = history.duplicated(["asset", "sec_info_start"], keep=False)
    if duplicate_starts.any():
        conflicts = (
            history.loc[duplicate_starts]
            .groupby(["asset", "sec_info_start"], observed=True)["sector"]
            .nunique(dropna=False)
        )
        if (conflicts > 1).any():
            raise ValueError(
                "CRSP sector history contains conflicting classifications for "
                "the same PERMNO and effective date."
            )
        history = history.drop_duplicates(["asset", "sec_info_start"], keep="last")

    history = history.sort_values(["asset", "sec_info_start", "sec_info_end"])
    previous_end = history.groupby("asset", observed=True)["sec_info_end"].shift()
    overlap = previous_end.notna() & history["sec_info_start"].le(previous_end)
    if overlap.any():
        examples = history.loc[overlap, ["asset", "sec_info_start"]].head()
        raise ValueError(
            "CRSP sector history contains overlapping effective intervals: "
            f"{examples.to_dict('records')}"
        )

    # pandas requires the temporal key to be globally sorted even with a
    # PERMNO grouping key.
    left = features.sort_values(["formation_date", "asset"])
    right_columns = [
        column
        for column in (
            "asset",
            "sec_info_start",
            "sec_info_end",
            "sector",
            "ues_industry",
            "icb_industry",
            "sic_code",
        )
        if column in history.columns
    ]
    right = history.loc[:, right_columns].sort_values(["sec_info_start", "asset"])
    merged = pd.merge_asof(
        left,
        right,
        by="asset",
        left_on="formation_date",
        right_on="sec_info_start",
        direction="backward",
        allow_exact_matches=True,
    )
    active = merged["formation_date"] <= merged["sec_info_end"]
    merged.loc[~active, "sector"] = pd.NA
    return merged.sort_values(["formation_date", "asset"]).reset_index(drop=True)


def select_balanced_monthly_membership(
    point_in_time_features: pd.DataFrame,
    config: BalancedUniverseConfig | None = None,
) -> pd.DataFrame:
    """Select equally capped sector branches from lagged CRSP characteristics."""

    cfg = config or BalancedUniverseConfig()
    cfg.validate()

    features = point_in_time_features.copy()
    _require_columns(
        features,
        {"formation_date", "asset", "sector", *MARKET_FEATURE_COLUMNS},
        "Point-in-time features",
    )
    features["formation_date"] = pd.to_datetime(
        features["formation_date"], errors="raise"
    )
    features["asset"] = _normalize_asset_ids(features["asset"])
    features["sector"] = _usable_sector_labels(features["sector"])
    for column in MARKET_FEATURE_COLUMNS:
        features[column] = pd.to_numeric(features[column], errors="coerce")

    features["formation_month"] = features["formation_date"].dt.to_period("M")
    monthly = (
        features.sort_values(["formation_date", "asset"])
        .groupby(["formation_month", "asset"], as_index=False, observed=True)
        .tail(1)
    )
    liquid = (
        monthly["sector"].notna()
        & (monthly["sector"] != "")
        & (monthly["market_cap_usd"] > 0.0)
        & (monthly["price"] >= float(cfg.minimum_price))
        & (monthly["dollar_volume_20d"] >= float(cfg.minimum_median_dollar_volume))
    )
    monthly = monthly.loc[liquid].copy()
    # Rank across the whole market before imposing equal sector counts. This
    # keeps every sector branch inside the same configured size tier.
    monthly["size_percentile"] = monthly.groupby("formation_month", observed=True)[
        "market_cap_usd"
    ].rank(method="first", pct=True)
    monthly = monthly.loc[
        monthly["size_percentile"] >= float(cfg.minimum_size_percentile)
    ].copy()

    monthly = monthly.sort_values(
        [
            "formation_month",
            "sector",
            "dollar_volume_20d",
            "market_cap_usd",
            "asset",
        ],
        ascending=[True, True, False, False, True],
        kind="mergesort",
    )
    monthly["sector_rank"] = (
        monthly.groupby(["formation_month", "sector"], observed=True).cumcount() + 1
    )
    selected = monthly.loc[monthly["sector_rank"] <= int(cfg.stocks_per_sector)].copy()
    sector_counts = selected.groupby("formation_month", observed=True)[
        "sector"
    ].nunique()
    valid_months = sector_counts.loc[sector_counts >= int(cfg.minimum_sectors)].index
    selected = selected.loc[selected["formation_month"].isin(valid_months)].copy()
    selected["effective_month"] = selected["formation_month"] + int(
        cfg.selection_lag_months
    )
    selected["selected"] = 1
    columns = [
        "formation_date",
        "formation_month",
        "effective_month",
        "asset",
        "sector",
        "sector_rank",
        "size_percentile",
        "market_cap_usd",
        "dollar_volume_20d",
        "selected",
    ]
    return selected.loc[:, columns].reset_index(drop=True)


def monthly_membership_to_weekly_pit(
    membership: pd.DataFrame,
    weekly_returns: pd.DataFrame,
    *,
    base_pit: pd.DataFrame | None = None,
) -> pd.DataFrame:
    """Expand lagged monthly membership and intersect an optional safety mask."""

    returns = weekly_returns.copy()
    returns.columns = returns.columns.astype(str)
    if returns.index.has_duplicates:
        raise ValueError("weekly_returns contains duplicate dates.")
    selected_assets = pd.Index(
        _normalize_asset_ids(membership["asset"]).dropna().unique()
    ).intersection(returns.columns)
    if len(selected_assets) < 2:
        raise ValueError("Balanced membership resolves fewer than two return columns.")

    pit = pd.DataFrame(0, index=returns.index, columns=selected_assets, dtype=np.int8)
    effective = membership.copy()
    effective["asset"] = _normalize_asset_ids(effective["asset"])
    for month, rows in effective.groupby("effective_month", observed=True):
        dates = pit.index[pit.index.to_period("M") == month]
        assets = selected_assets.intersection(rows["asset"])
        if len(dates) and len(assets):
            pit.loc[dates, assets] = 1

    if base_pit is not None:
        safety = base_pit.copy()
        safety.columns = safety.columns.astype(str)
        safety = (
            safety.reindex(index=pit.index, columns=pit.columns).fillna(0).astype(bool)
        )
        pit = (pit.astype(bool) & safety).astype(np.int8)
    return pit


FACTOR_DEFINITIONS = {
    # factor name: (signal column, long the low-signal leg)
    "CRSP_SIZE": ("market_cap_usd", True),
    "CRSP_VALUE": ("book_to_market", False),
    "CRSP_MOMENTUM": ("momentum", False),
    "CRSP_LOW_VOL": ("low_volatility", True),
}


def _long_short_return(
    realized_returns: pd.Series,
    long_assets: pd.Index,
    short_assets: pd.Index,
    minimum_observations_per_leg: int,
) -> float:
    """Calculate an equal-weight spread only when both legs are observable."""

    long_returns = realized_returns.reindex(long_assets).dropna()
    short_returns = realized_returns.reindex(short_assets).dropna()
    if (
        len(long_returns) < minimum_observations_per_leg
        or len(short_returns) < minimum_observations_per_leg
    ):
        return np.nan
    return float(long_returns.mean() - short_returns.mean())


def build_style_factor_proxies(
    weekly_returns: pd.DataFrame,
    point_in_time_features: pd.DataFrame,
    *,
    eligible_mask: pd.DataFrame | None = None,
    minimum_leg_assets: int = 10,
    quantile: float = 0.30,
    minimum_price: float = 5.0,
    minimum_median_dollar_volume: float = 1_000_000.0,
    minimum_realized_leg_fraction: float = 0.80,
) -> pd.DataFrame:
    """Build causal CRSP size, value, momentum and low-volatility proxies.

    These are research factors rather than cash assets. They are intended for
    ``--factor-returns`` in the Mapper/factor model unless the user has an
    explicit implementation for financing and shorting both legs. ``CRSP_VALUE``
    is emitted only when a release-aware ``book_to_market`` column is supplied.
    """

    if minimum_leg_assets < 2:
        raise ValueError("minimum_leg_assets must be at least 2.")
    if not 0.0 < quantile < 0.5:
        raise ValueError("quantile must be in (0, 0.5).")
    if not 0.0 < minimum_realized_leg_fraction <= 1.0:
        raise ValueError("minimum_realized_leg_fraction must be in (0, 1].")
    if minimum_price < 0.0:
        raise ValueError("minimum_price cannot be negative.")
    if minimum_median_dollar_volume < 0.0:
        raise ValueError("minimum_median_dollar_volume cannot be negative.")
    returns = weekly_returns.copy().astype(float).sort_index()
    returns.columns = returns.columns.astype(str)
    if returns.index.has_duplicates:
        raise ValueError("weekly_returns contains duplicate dates.")
    eligibility = None
    if eligible_mask is not None:
        eligibility = eligible_mask.copy()
        eligibility.columns = eligibility.columns.astype(str)
        eligibility = (
            eligibility.reindex(index=returns.index, columns=returns.columns)
            .fillna(0)
            .astype(bool)
        )
    # The four-week shift implements conventional 12-1 momentum: the most
    # recent month is excluded before compounding the preceding 48 weeks.
    log_returns = np.log1p(returns.clip(lower=-0.999999))
    momentum = np.expm1(log_returns.shift(4).rolling(48, min_periods=48).sum())
    # Volatility is also shifted so the formation-week return cannot enter its
    # own ranking.
    low_volatility = returns.shift(1).rolling(52, min_periods=52).std(ddof=1)

    features = point_in_time_features.copy()
    _require_columns(
        features,
        {"formation_date", "asset", *MARKET_FEATURE_COLUMNS},
        "Point-in-time features",
    )
    features["formation_date"] = pd.to_datetime(
        features["formation_date"], errors="raise"
    )
    features["asset"] = _normalize_asset_ids(features["asset"])
    features["formation_month"] = features["formation_date"].dt.to_period("M")
    monthly = (
        features.sort_values(["formation_date", "asset"])
        .groupby(["formation_month", "asset"], as_index=False, observed=True)
        .tail(1)
    )
    factor_columns = [
        factor
        for factor, (signal, _) in FACTOR_DEFINITIONS.items()
        if signal != "book_to_market" or signal in monthly.columns
    ]
    output = pd.DataFrame(np.nan, index=returns.index, columns=factor_columns)

    for formation_month, snapshot in monthly.groupby("formation_month", observed=True):
        formation_dates = returns.index[returns.index.to_period("M") == formation_month]
        if len(formation_dates) == 0:
            continue
        formation_date = formation_dates[-1]
        assets = returns.columns.intersection(snapshot["asset"])
        if eligibility is not None:
            assets = assets.intersection(
                eligibility.columns[eligibility.loc[formation_date]]
            )
        if len(assets) < 2 * minimum_leg_assets:
            continue
        signals = snapshot.set_index("asset").reindex(assets)
        numeric_columns = [
            column
            for column in (
                "market_cap_usd",
                "price",
                "dollar_volume_20d",
                "book_to_market",
            )
            if column in signals.columns
        ]
        signals[numeric_columns] = signals[numeric_columns].apply(
            pd.to_numeric, errors="coerce"
        )
        liquid = (
            (signals["market_cap_usd"] > 0.0)
            & (signals["price"] >= float(minimum_price))
            & (signals["dollar_volume_20d"] >= float(minimum_median_dollar_volume))
        )
        signals = signals.loc[liquid].copy()
        signals["momentum"] = momentum.loc[formation_date].reindex(assets)
        signals["low_volatility"] = low_volatility.loc[formation_date].reindex(assets)
        signals = signals.replace([np.inf, -np.inf], np.nan)
        effective_month = formation_month + 1
        realized_dates = returns.index[returns.index.to_period("M") == effective_month]

        # Rankings formed in month t are held during month t+1. This lag is
        # separate from, and in addition to, each signal's own data lag.
        for factor in factor_columns:
            column, long_low_signal = FACTOR_DEFINITIONS[factor]
            ranked = signals[column].dropna().sort_values()
            leg_size = max(minimum_leg_assets, int(np.floor(len(ranked) * quantile)))
            if 2 * leg_size > len(ranked):
                continue
            low = ranked.index[:leg_size]
            high = ranked.index[-leg_size:]
            long_leg, short_leg = (low, high) if long_low_signal else (high, low)
            minimum_realized = max(
                2,
                int(np.ceil(leg_size * minimum_realized_leg_fraction)),
            )
            for realized_date in realized_dates:
                output.at[realized_date, factor] = _long_short_return(
                    returns.loc[realized_date],
                    long_leg,
                    short_leg,
                    minimum_realized,
                )
    return output
